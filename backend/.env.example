# Copy to .env and fill in for local development.
# In production (Railway) these are set as service Variables instead.

DATABASE_URL=postgresql+asyncpg://lucaku:lucaku@localhost:5432/lucaku_audio
SECRET_KEY=change_this_to_a_long_random_value
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Episode Generator voicing. Without this, episodes still publish
# with a full script but no audio (job status stays "voicing").
ELEVENLABS_API_KEY=
